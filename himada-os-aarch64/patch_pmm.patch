+    pub fn free_frames(&mut self, phys_addr: usize, pages: usize) {
+        let start_idx = phys_addr / 4096;
+        for j in start_idx..(start_idx + pages) {
+            self.bitmap[j / 8] &= !(1 << (j % 8));
+        }
+        self.free_frames += pages;
+    }
