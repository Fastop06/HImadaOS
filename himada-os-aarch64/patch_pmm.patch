+    pub fn alloc_frames(&mut self, pages: usize) -> Option<usize> {
+        if self.free_frames < pages {
+            return None;
+        }
+        let mut count = 0;
+        let mut start_idx = 0;
+        
+        for i in 0..self.bitmap_size {
+            let bit = 1 << (i % 8);
+            let byte = i / 8;
+            if (self.bitmap[byte] & bit) == 0 {
+                if count == 0 { start_idx = i; }
+                count += 1;
+                if count == pages {
+                    for j in start_idx..(start_idx + pages) {
+                        self.bitmap[j / 8] |= 1 << (j % 8);
+                    }
+                    self.free_frames -= pages;
+                    return Some(start_idx * 4096);
+                }
+            } else {
+                count = 0;
+            }
+        }
+        None
+    }
 
